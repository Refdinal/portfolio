# Base URL of the deployed site (used in metadata, sitemap, canonical, OG)
NEXT_PUBLIC_SITE_URL=https://refdinal.com

# Google Analytics 4 measurement ID (NEXT_PUBLIC_ so it's sent to browser).
# Jika diisi, memakai nilai ini; jika kosong, kode menggunakan default:
# G-TY9ZHLBTDM
NEXT_PUBLIC_GA_ID=
